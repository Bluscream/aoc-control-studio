{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AOC Control Studio",
  "version": "1.0.1",
  "identifier": "com.aoc.controlstudio",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AOC Control Studio",
        "url": "index.html",
        "width": 860,
        "height": 740,
        "minWidth": 620,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true,
        "theme": "Dark",
        "decorations": false,
        "shadow": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Controle DDC/CI para monitores AOC",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"],
        "files": {
          "/usr/lib/udev/rules.d/60-aoc-control-studio-i2c.rules": "linux/60-aoc-control-studio-i2c.rules",
          "/usr/lib/modules-load.d/aoc-control-studio-i2c.conf": "linux/i2c-dev.conf"
        },
        "postInstallScript": "linux/postinst.sh"
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/60-aoc-control-studio-i2c.rules": "linux/60-aoc-control-studio-i2c.rules",
          "/usr/lib/modules-load.d/aoc-control-studio-i2c.conf": "linux/i2c-dev.conf"
        },
        "postInstallScript": "linux/postinst.sh"
      }
    }
  }
}
