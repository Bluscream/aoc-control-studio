{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AOC Control Studio",
  "version": "1.0.0",
  "identifier": "com.aoc.controlstudio",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AOC Control Studio",
        "url": "index.html",
        "width": 860,
        "height": 740,
        "minWidth": 620,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true,
        "theme": "Dark",
        "decorations": false,
        "shadow": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
