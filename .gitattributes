# Normalização automática de quebras de linha para evitar conflitos Windows (CRLF) vs Linux (LF)
* text=auto

*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.sh text eol=lf

*.bat text eol=crlf
*.ps1 text eol=crlf

*.exe binary
*.dll binary
*.ico binary
*.png binary
*.icns binary
